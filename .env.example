# Copy to .env and fill in. `make` loads .env automatically when present.
# .env is gitignored; nothing here is read by OpenTofu directly, it only
# configures the AWS session and the Makefile.

# The named profile `aws configure` wrote. Everything -- OpenTofu, the AWS CLI,
# kubectl -- authenticates through it; no credential is ever stored in this repo.
AWS_PROFILE=workshop

# Drives both the AWS CLI and OpenTofu's var.region. Change it in one place.
AWS_REGION=eu-central-1

# Number of participant accounts to mint (`make roster`). Mint a few spares:
# an extra account costs nothing and a latecomer without one costs the room's
# attention.
PARTICIPANTS=5

# Container image tag pushed to ECR and deployed by Helm.
IMAGE_TAG=v1
