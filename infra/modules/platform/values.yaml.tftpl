# Generated by infra/modules/platform. The per-workshop leaves only; every
# structural decision lives in charts/workshop/values.yaml.
image:
  repository: ${image.repository}
  tag: ${image.tag}

dataset:
  uri: ${jsonencode(dataset.uri)}
  mountPath: ${data_path}
  awsRoleArn: ${jsonencode(dataset.reader_role_arn)}

seat:
  cpu: ${seat.vcpu}
  memoryGi: ${seat.memory_gib}
  diskGi: ${seat.disk_gib}

roster: ${roster_json}

jupyterhub:
  singleuser:
    image:
      name: ${image.repository}
      tag: ${image.tag}
    cpu:
      guarantee: ${seat.vcpu}
      limit: ${seat.vcpu}
    memory:
      guarantee: ${seat.memory_gib}G
      limit: ${seat.memory_gib}G
    storage:
      extraVolumes:
        - name: dataset
          emptyDir:
            sizeLimit: ${seat.disk_gib}Gi
      extraVolumeMounts:
        - name: dataset
          mountPath: ${data_path}
%{ if dataset.uri != "" ~}
    # The dataset is copied into the seat before JupyterLab starts, so a
    # participant never sees a half-populated /data.
    initContainers:
      - name: dataset-sync
        image: public.ecr.aws/aws-cli/aws-cli:2.22.35
        command:
          - aws
          - s3
          - sync
          - ${dataset.uri}
          - ${data_path}
          - --only-show-errors
        volumeMounts:
          - name: dataset
            mountPath: ${data_path}
%{ endif ~}
